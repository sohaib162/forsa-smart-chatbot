# ============================================================
# Forsa Smart Chatbot — Environment Configuration
# ============================================================

# --- Local LLM ---
LOCAL_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# --- MinIO Object Storage ---
# ⚠️ Change these before deploying to production!
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- DeepSeek API (optional fallback LLM) ---
# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_API_URL=https://api.modelarts-maas.com/v2/chat/completions

# --- Chatbot API ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=120

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_CHAT_API_BASE_URL=http://localhost:8001
