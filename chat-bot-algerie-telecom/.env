# ============================================================
# Forsa Smart Chatbot — Environment Configuration
# ============================================================
# Architecture: PrivateGPT-style (100% Offline, Data Sovereign)
# ============================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
SERVER_LOG_LEVEL=INFO
SERVER_PIPELINE_TIMEOUT_SECONDS=120
SERVER_ENV_NAME=local

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173"]

# --- Local LLM (Qwen 2.5 3B) ---
LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.85
LLM_TOP_K=20
LLM_REPETITION_PENALTY=1.15
LLM_DEVICE=auto
LLM_GPU_MEMORY_LIMIT=4.5GB
LLM_CPU_MEMORY_LIMIT=8GB

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Vector Store (Qdrant) ---
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_QDRANT_PATH=./data/qdrant_storage
VECTOR_STORE_COLLECTION_NAME=forsa_documents

# --- MinIO Object Storage ---
# ⚠️ Change these before deploying to production!
S3_ENDPOINT=minio:9000
S3_EXTERNAL_ENDPOINT=localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false
S3_BUCKET=forsa-documents

# --- Document Ingestion ---
INGEST_CHUNK_SIZE=1024
INGEST_CHUNK_OVERLAP=128

# --- Legacy (backward compat) ---
LOCAL_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=120
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- DeepSeek API (optional fallback, DISABLED for offline mode) ---
# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_API_URL=https://api.modelarts-maas.com/v2/chat/completions
